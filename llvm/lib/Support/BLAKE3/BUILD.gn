import("//build/llvm_library.gni")

config("disable_blake3_x86_simd") {
    defines = [
        "BLAKE3_NO_AVX512",
        "BLAKE3_NO_AVX2",
        "BLAKE3_NO_SSE41",
        "BLAKE3_NO_SSE2"
    ]
}

llvm_static_library("LLVMSupportBlake3") {
    sources = [
        "blake3.c",
        "blake3_dispatch.c",
        "blake3_portable.c",
        "blake3_neon.c",

        "blake3_sse2_x86-64_unix.S",
        "blake3_sse41_x86-64_unix.S",
        "blake3_avx2_x86-64_unix.S",
        "blake3_avx512_x86-64_unix.S",
    ]

    deps = [
        ":disable_blake3_x86_simd",
    ]
}